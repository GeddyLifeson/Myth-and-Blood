{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM"],
    "rootDir": "src",
    "outDir": "js",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
